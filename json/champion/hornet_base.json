            "gender": "female",
            "added_expressions": [ { "english": "Git gud!" }, { "english": "Shaw!" }, { "english": "Adeedno!" } ],
            "idle_expressions": [
                { "english": "This train... it's different from the stagways." },
                { "english": "This old train... A terrible contraption. Rust, I can smell it in the air..." },
                { "english": "Again we meet little ghost... huh?" },
                { "english": "Ella!" },
                { "english": "They hunt me for my nature. For the silk produced within my shell. Not for themselves but for the one atop it all." }
            ]
        }
