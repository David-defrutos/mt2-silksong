        { "id": "HornetProtector3ImbueProtectTrigger", "trigger": "on_any_unit_death_on_floor", "effects": [ { "id": "@HornetProtector3ImbueEffect" }, { "id": "@HornetProtector3ProtectEffect" } ], "descriptions": { "english": "Apply [effect0.status0.power] [Silk_Song_Clan.Plugin_PermanentImbue] and [effect1.status0.power] [Silk_Song_Clan.Plugin_PermanentProtection] to friendly units." } }
