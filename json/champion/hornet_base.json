        { "id": "HornetProtector3", "titles": { "english": "Protector", "chinese": "野兽纹章" }, "bonus_damage": 45, "bonus_hp": 30, "trigger_upgrades": [ "@HornetProtector3ImbueProtectTrigger" ] }
