    "chatter": [
        {
            "id": "CTR_Lace",
            "gender": "female",
            "added_expressions": [
                { "english": "Hmph." },
                { "english": "Predictable." },
                { "english": "Stand aside." }
            ],
            "idle_expressions": [
                { "english": "A carriage of rust and cinders. How very beneath me." },
                { "english": "You fight without form. Without discipline. It offends me more than the wound." },
                { "english": "Needle and thread, and a debt still owed. I have not forgotten it." },
                { "english": "Feed them to me, then. I will not refuse a gift so poorly guarded." },
                { "english": "Every silk thread ends somewhere. Mine ends where I choose." }
            ]
        }
